<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — HKTech Admin</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        /* ── Admin Layout ─────────────────────────────────────────── */
        body { background: #0A0A0A; }

        .admin-wrapper { display: flex; min-height: 100vh; }

        /* Sidebar */
        .admin-sidebar {
            width: 240px;
            background: var(--bg-surface);
            border-right: 2px solid var(--gold-dim);
            display: flex;
            flex-direction: column;
            position: fixed;
            top: 0; left: 0; bottom: 0;
            z-index: 100;
        }

        .admin-sidebar-brand {
            padding: 20px 16px;
            border-bottom: 1px solid #222;
            font-family: var(--font-pixel);
            font-size: 0.55rem;
            color: var(--gold);
            text-shadow: var(--glow-gold);
        }

        .admin-nav { flex: 1; padding: 12px 0; }

        .admin-nav-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 16px;
            font-family: var(--font-mono);
            font-size: 0.85rem;
            color: var(--text-muted);
            text-decoration: none;
            transition: all var(--transition-fast);
            border-left: 3px solid transparent;
        }

        .admin-nav-item:hover {
            color: var(--gold);
            background: var(--gold-glow);
            border-left-color: var(--gold-dim);
        }

        .admin-nav-item.active {
            color: var(--gold);
            background: var(--gold-glow);
            border-left-color: var(--gold);
        }

        .admin-nav-section {
            font-family: var(--font-pixel);
            font-size: 0.4rem;
            color: var(--text-muted);
            padding: 12px 16px 4px;
            letter-spacing: 2px;
        }

        /* Main */
        .admin-main {
            margin-left: 240px;
            flex: 1;
            display: flex;
            flex-direction: column;
        }

        .admin-topbar {
            background: var(--bg-surface);
            border-bottom: 1px solid #222;
            padding: 12px 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .admin-page-title {
            font-family: var(--font-pixel-vn);
            font-size: 1.2rem;
            color: var(--gold);
        }

        .admin-content {
            padding: 24px;
            flex: 1;
        }

        /* Cards */
        .admin-stat-card {
            background: var(--bg-surface);
            border: var(--border-muted);
            border-top: 3px solid var(--gold-dim);
            padding: 20px;
            text-align: center;
        }

        .stat-icon { font-size: 2rem; margin-bottom: 8px; }
        .stat-value {
            font-family: var(--font-pixel);
            font-size: 1.2rem;
            color: var(--gold);
            text-shadow: var(--glow-gold);
        }
        .stat-label { font-family: var(--font-mono); font-size: 0.8rem; color: var(--text-muted); margin-top: 4px; }

        .admin-card {
            background: var(--bg-surface);
            border: var(--border-muted);
        }

        .admin-card-header {
            padding: 12px 16px;
            border-bottom: 1px solid #222;
            background: var(--bg-void);
        }

        .admin-card-body { padding: 16px; }

        /* Table */
        .admin-table {
            width: 100%;
            border-collapse: collapse;
            font-family: var(--font-mono);
            font-size: 0.85rem;
        }

        .admin-table th {
            font-family: var(--font-pixel);
            font-size: 0.4rem;
            color: var(--gold);
            padding: 10px 12px;
            text-align: left;
            border-bottom: 1px solid #333;
            letter-spacing: 1px;
        }

        .admin-table td {
            padding: 10px 12px;
            border-bottom: 1px solid #1A1A1A;
            color: var(--text-secondary);
            vertical-align: middle;
        }

        .admin-table tr:hover td { background: rgba(255,215,0,0.03); }

        .badge-status {
            font-family: var(--font-mono);
            font-size: 0.7rem;
            padding: 2px 8px;
            background: var(--bg-void);
            border: 1px solid #444;
            color: var(--text-muted);
        }

        /* Pagination */
        .admin-pagination { display: flex; gap: 4px; margin-top: 16px; }
        .page-btn {
            font-family: var(--font-mono);
            font-size: 0.8rem;
            padding: 4px 10px;
            background: var(--bg-void);
            border: 1px solid #333;
            color: var(--text-muted);
            text-decoration: none;
            cursor: pointer;
        }
        .page-btn:hover, .page-btn.active { border-color: var(--gold); color: var(--gold); }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="admin-wrapper">
        <!-- Sidebar -->
        <aside class="admin-sidebar">
            <div class="admin-sidebar-brand">
                ♥ HKTECH<br/>
                <span style="color:var(--red-soul); font-size:0.4rem;">ADMIN PANEL</span>
            </div>

            <nav class="admin-nav">
                <div class="admin-nav-section">TỔNG QUAN</div>
                <a class="admin-nav-item" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                    <i class="bi bi-speedometer2"></i> Dashboard
                </a>

                <div class="admin-nav-section">QUẢN LÝ</div>
                <a class="admin-nav-item" asp-area="Admin" asp-controller="ProductAdmin" asp-action="Index">
                    <i class="bi bi-cpu"></i> Sản phẩm
                </a>
                <a class="admin-nav-item" asp-area="Admin" asp-controller="CategoryAdmin" asp-action="Index">
                    <i class="bi bi-folder2"></i> Danh mục
                </a>

                <div class="admin-nav-section">HỆ THỐNG</div>
                <a class="admin-nav-item" asp-controller="Home" asp-action="Index" target="_blank">
                    <i class="bi bi-box-arrow-up-right"></i> Xem trang chủ
                </a>
                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="admin-nav-item border-0 w-100 text-start" style="background:none; cursor:pointer;">
                        <i class="bi bi-box-arrow-right"></i> Đăng xuất
                    </button>
                </form>
            </nav>
        </aside>

        <!-- Main -->
        <div class="admin-main">
            <div class="admin-topbar">
                <div class="admin-page-title">@ViewData["Title"]</div>
                <div class="text-mono" style="font-size:0.8rem; color:var(--text-muted);">
                    👤 @User.Identity?.Name
                </div>
            </div>

            <div class="admin-content">
                @{
                    var success = TempData["Success"] as string;
                    var error   = TempData["Error"]   as string;
                }
                @if (success != null)
                {
                    <div class="alert-ut alert-ut-success mb-3">@success
                        <button onclick="this.parentElement.remove()" style="float:right;background:none;border:none;cursor:pointer;color:inherit;">✕</button>
                    </div>
                }
                @if (error != null)
                {
                    <div class="alert-ut alert-ut-danger mb-3">@error
                        <button onclick="this.parentElement.remove()" style="float:right;background:none;border:none;cursor:pointer;color:inherit;">✕</button>
                    </div>
                }

                @RenderBody()
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
