@{
    ViewData["Title"] = "Build PC";
    ViewData["Description"] = "Pick parts for each slot, check compatibility real-time, and get instant FPS estimation.";
}

@section Styles {
<style>
    /* Build Page specific */
    .build-page-grid {
        display: grid;
        grid-template-columns: 1fr 380px;
        gap: var(--space-xl);
        align-items: start;
    }
    @@media (max-width: 992px) {
        .build-page-grid { grid-template-columns: 1fr; }
    }

    .total-panel {
        background: var(--bg-surface);
        border: var(--border-gold);
        padding: var(--space-lg);
        position: sticky;
        top: 80px;
    }

    /* .total-label đã được thay thế bằng .panel-label-vn (VT323) trong HTML */

    .total-price {
        font-family: var(--font-pixel);
        font-size: 1.1rem;
        color: var(--gold);
        text-shadow: var(--glow-gold);
        transition: all 0.3s ease;
    }

    .total-price.bump {
        transform: scale(1.15);
        color: #FFF176;
    }

    /* Compatibility status */
    .compat-status {
        margin-top: var(--space-md);
        border-top: var(--border-muted);
        padding-top: var(--space-md);
    }

    .compat-item {
        display: flex;
        align-items: center;
        gap: var(--space-sm);
        font-family: var(--font-mono);
        font-size: 0.8rem;
        margin-bottom: var(--space-xs);
        color: var(--text-muted);
    }

    .compat-item.ok     { color: var(--green-kindness); }
    .compat-item.warn   { color: var(--gold); }
    .compat-item.error  { color: var(--red-soul); }

    /* Bottleneck bar */
    .bottleneck-section {
        margin-top: var(--space-md);
        border-top: var(--border-muted);
        padding-top: var(--space-md);
    }

    .bottleneck-bar-wrap {
        background: #111;
        border: 1px solid #333;
        height: 20px;
        position: relative;
        margin: var(--space-sm) 0;
        overflow: hidden;
    }

    .bottleneck-bar-cpu {
        position: absolute;
        left: 0; top: 0; bottom: 0;
        background: linear-gradient(90deg, var(--blue-patience), transparent);
        transition: width 0.6s ease;
    }

    .bottleneck-bar-gpu {
        position: absolute;
        right: 0; top: 0; bottom: 0;
        background: linear-gradient(270deg, var(--red-soul), transparent);
        transition: width 0.6s ease;
    }

    .bottleneck-center {
        position: absolute;
        left: 50%; top: 50%;
        transform: translate(-50%,-50%);
        font-family: var(--font-pixel);
        font-size: 0.4rem;
        color: var(--gold);
        white-space: nowrap;
        text-shadow: var(--glow-gold);
    }

    /* FPS table */
    .fps-table {
        width: 100%;
        border-collapse: collapse;
        font-family: var(--font-mono);
        font-size: 0.75rem;
        margin-top: var(--space-sm);
    }

    .fps-table th {
        font-family: var(--font-pixel);
        font-size: 0.4rem;
        color: var(--gold);
        padding: 4px 6px;
        text-align: center;
        border-bottom: 1px solid #333;
    }

    .fps-table td {
        padding: 4px 6px;
        color: var(--text-secondary);
        border-bottom: 1px solid #1A1A1A;
        text-align: center;
    }

    .fps-table td:first-child { text-align: left; color: var(--text-primary); }
    .fps-table .fps-good  { color: var(--green-kindness); }
    .fps-table .fps-ok    { color: var(--gold); }
    .fps-table .fps-bad   { color: var(--red-soul); }

    /* Select modal */
    .select-panel {
        background: var(--bg-card);
        border: var(--border-gold);
        padding: var(--space-lg);
        margin-top: var(--space-xl);
        display: none;
    }

    .select-panel.active { display: block; animation: slideDown 0.2s ease; }

    @@keyframes slideDown {
        from { opacity: 0; transform: translateY(-10px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    .mini-product-list { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px,1fr)); gap: var(--space-md); }

    .mini-product-item {
        background: var(--bg-surface);
        border: 1px solid #2A2A2A;
        padding: var(--space-sm);
        cursor: pointer;
        transition: all var(--transition-fast);
        display: flex;
        align-items: center;
        gap: var(--space-sm);
    }

    .mini-product-item:hover { border-color: var(--gold); background: var(--gold-glow); }
    .mini-product-item.selected { border-color: var(--green-kindness); background: rgba(68,204,68,0.1); }

    .mini-product-img { width: 48px; height: 48px; object-fit: contain; background: #111; padding: 4px; }
    .mini-product-name { font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-primary); }
    .mini-product-price { font-family: var(--font-pixel); font-size: 0.45rem; color: var(--gold); }
</style>
}

<div class="container-hk" style="padding-top: var(--space-xl);">

    <!-- Page Header -->
    <div class="section-header">
        <h1 class="section-title-pixel">⚙️ BUILD YOUR PC</h1>
        <div class="section-line"></div>
    </div>

    <div class="dialog-box mb-4">
        Select parts for each slot. The system will <span class="text-gold">auto-check compatibility</span> and <span style="color:var(--green-kindness);">estimate FPS</span> in real-time.
    </div>

    <div class="build-page-grid">

        <!-- LEFT: Slot List -->
        <div>
            @{
                var slots = new[]
                {
                    new { Key = "cpu",       Icon = "🧠", Label = "CPU",          IsVn = false, Placeholder = "Choose processor..." },
                    new { Key = "mainboard", Icon = "🧩", Label = "MAINBOARD",    IsVn = false, Placeholder = "Choose motherboard..." },
                    new { Key = "ram",       Icon = "💾", Label = "RAM",          IsVn = false, Placeholder = "Choose RAM..." },
                    new { Key = "gpu",       Icon = "🎮", Label = "GPU",          IsVn = false, Placeholder = "Choose graphics card..." },
                    new { Key = "storage",   Icon = "💿", Label = "STORAGE",      IsVn = false,  Placeholder = "Choose storage..." },
                    new { Key = "psu",       Icon = "⚡",  Label = "POWER SUPPLY", IsVn = false,  Placeholder = "Choose power supply..." },
                    new { Key = "case",      Icon = "🗄️",  Label = "CASE",        IsVn = false,  Placeholder = "Choose PC case..." },
                    new { Key = "cooling",   Icon = "❄️",  Label = "COOLING",     IsVn = false,  Placeholder = "Choose CPU cooler..." },
                };
            }
            <div id="build-slots">
                @foreach (var slot in slots)
                {
                    <div class="build-slot" id="slot-@slot.Key" data-slot="@slot.Key">
                        <span class="slot-icon">@slot.Icon</span>
                        @if (slot.IsVn)
                        {
                            <span class="slot-label">@slot.Label</span>
                        }
                        else
                        {
                            <span class="slot-label-en">@slot.Label</span>
                        }
                        <span class="slot-selected text-muted-hk" id="selected-@slot.Key">@slot.Placeholder</span>
                        <span class="slot-price text-muted-hk" id="price-@slot.Key">—</span>
                        <button class="btn-ut btn-ut-outline btn-vn"
                                onclick="openSelectPanel('@slot.Key', '@slot.Label')"
                                id="btn-select-@slot.Key">
                            CHOOSE
                        </button>
                        <button class="btn-ut btn-ut-ghost btn-vn"
                                onclick="clearSlot('@slot.Key')"
                                id="btn-clear-@slot.Key"
                                style="display:none;">
                            ✕
                        </button>
                    </div>
                }
            </div>

            <!-- Product Select Panel (appears below slots) -->
            <div class="select-panel" id="selectPanel">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="text-pixel-vn text-gold" style="font-size:1.1rem;" id="panelTitle">CHOOSE COMPONENT</div>
                    <button class="btn-ut btn-ut-ghost btn-en" onclick="closeSelectPanel()">✕ CLOSE</button>
                </div>
                <!-- Search -->
                <div class="form-hk mb-3">
                    <input type="text" class="form-control-hk" id="productSearch"
                           placeholder="Search components..." oninput="filterProducts(this.value)" />
                </div>
                <!-- Product Grid -->
                <div class="mini-product-list" id="productList">
                    <div class="text-mono text-muted-hk">
                        * Data will load from the database.<br/>
                        System is currently being configured...
                    </div>
                </div>
            </div>

            <!-- Build Action Buttons -->
            <div class="mt-4 d-flex gap-3 flex-wrap" id="build-actions">
                <button class="btn-ut btn-ut-primary btn-en" id="btn-add-all-to-cart" onclick="addBuildToCart()" style="padding: 12px 20px;">
                    ADD TO CART
                </button>
                <button class="btn-ut btn-ut-outline btn-en" onclick="toggleSavePanel()" id="btn-save-build">
                    SAVE BUILD
                </button>
                <button class="btn-ut btn-ut-ghost btn-en" onclick="clearBuild()" id="btn-clear-build">
                    CLEAR
                </button>
            </div>
            <!-- Save Build Panel -->
            <div id="saveBuildPanel" style="display:none; margin-top:12px;" class="d-flex gap-2">
                <input type="text" class="form-control-hk" id="buildNameInput"
                       placeholder="Build name..." style="flex:1; font-size:0.75rem;"/>
                <button class="btn-ut btn-ut-primary btn-en" onclick="saveBuild()">SAVE</button>
                <button class="btn-ut btn-ut-ghost btn-en" onclick="toggleSavePanel()">✕</button>
            </div>
        </div>

        <!-- RIGHT: Total & Smart Build Panel -->
        <div class="total-panel" id="totalPanel">

            <!-- Total Price -->
            <div class="text-vn-mono mb-1" style="font-size:0.85rem;">TOTAL BUILD COST</div>
            <div class="total-price" id="totalPrice">0 ₫</div>
            <div class="text-mono mt-1" style="font-size:0.75rem; color:var(--text-muted);">
                <span id="slotsFilled">0</span>/8 parts selected
            </div>

            <!-- ===============================================
                 COMPATIBILITY GUARD
                 =============================================== -->
            <div class="compat-status">
                <div class="panel-label-en mb-2">
                    🛡️ COMPATIBILITY GUARD
                </div>
                <div class="compat-item" id="compat-socket">
                    <span>⬜</span> Socket CPU / Mainboard
                </div>
                <div class="compat-item" id="compat-ram">
                    <span>⬜</span> RAM Type (DDR4/DDR5)
                </div>
                <div class="compat-item" id="compat-psu">
                    <span>⬜</span> PSU Wattage vs TDP
                </div>
                <div class="compat-item" id="compat-form">
                    <span>⬜</span> Form Factor (ATX/mATX)
                </div>
            </div>

            <!-- ===============================================
                 BOTTLENECK ANALYZER
                 =============================================== -->
            <div class="bottleneck-section">
                <div class="panel-label-en mb-2">
                    📊 BOTTLENECK ANALYZER
                </div>
                <div class="d-flex justify-content-between text-mono mb-1" style="font-size:0.7rem;">
                    <span style="color: var(--blue-patience);">CPU</span>
                    <span style="color: var(--text-muted);">vs</span>
                    <span style="color: var(--red-soul);">GPU</span>
                </div>
                <div class="bottleneck-bar-wrap" id="bottleneckBar">
                    <div class="bottleneck-bar-cpu" id="barCpu" style="width:50%;"></div>
                    <div class="bottleneck-bar-gpu" id="barGpu" style="width:50%;"></div>
                    <div class="bottleneck-center" id="bottleneckLabel">—</div>
                </div>
                <div class="text-mono mt-1" style="font-size:0.75rem; color:var(--text-muted);" id="bottleneckHint">
                    * Select CPU & GPU to see analysis
                </div>
            </div>

            <!-- ===============================================
                 FPS ESTIMATOR
                 =============================================== -->
            <div class="bottleneck-section">
                <div class="panel-label-en mb-2">
                    🎮 FPS ESTIMATOR
                </div>
                <div id="fpsTableWrap">
                    <div class="text-mono" style="font-size:0.75rem; color:var(--text-muted);">
                        * Select CPU + GPU to see FPS estimation
                    </div>
                </div>
            </div>

            <!-- Build Badge -->
            <div class="mt-3" id="buildBadge" style="display:none;">
                <span class="badge-ut badge-ut-gold" id="buildBadgeText">🎮 GAMING BUILD</span>
            </div>

        </div>
    </div>
</div>

@section Scripts {
@{
    var initBuild = ViewBag.CurrentBuild as Dictionary<string, HKTech.Controllers.BuildSlotItem>;
}
<script>
    // ============================================================
    // BUILD STATE — restored from server session
    // ============================================================
    const serverBuild = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        initBuild ?? new Dictionary<string, HKTech.Controllers.BuildSlotItem>(),
        new System.Text.Json.JsonSerializerOptions
        {
            PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase
        }));

    const buildState = {
        cpu: null, mainboard: null, ram: null, gpu: null,
        storage: null, psu: null, case: null, cooling: null
    };

    let currentSlot = null;
    let allProducts  = [];   // products loaded for current slot
    const PRICE_FORMATTER = new Intl.NumberFormat('vi-VN', { style:'currency', currency:'VND' });

    // ============================================================
    // RESTORE SESSION STATE ON PAGE LOAD
    // ============================================================
    document.addEventListener('DOMContentLoaded', () => {
        for (const [slot, item] of Object.entries(serverBuild)) {
            if (item && buildState.hasOwnProperty(slot)) {
                buildState[slot] = item;
                updateSlotUI(slot, item);
            }
        }
        updateTotals();
        runCompatibilityCheck();
        runPerformanceAnalysis();
    });

    // ============================================================
    // OPEN / CLOSE SELECT PANEL
    // ============================================================
    function openSelectPanel(slotKey, slotLabel) {
        currentSlot = slotKey;
        document.getElementById('panelTitle').textContent = `CHOOSE ${slotLabel}`;
        document.getElementById('selectPanel').classList.add('active');
        document.getElementById('productSearch').value = '';
        document.getElementById('productList').innerHTML =
            '<div class="text-mono text-muted-hk">Loading...</div>';
        document.getElementById('selectPanel').scrollIntoView({ behavior: 'smooth', block: 'start' });
        loadProductsForSlot(slotKey);
    }

    function closeSelectPanel() {
        document.getElementById('selectPanel').classList.remove('active');
        currentSlot = null;
    }

    // ============================================================
    // LOAD PRODUCTS FROM API
    // ============================================================
    async function loadProductsForSlot(slot) {
        try {
            const res  = await fetch(`/Build/GetProducts?slot=${slot}`);
            const data = await res.json();
            if (!data.success) throw new Error();
            allProducts = data.products;
            renderProducts(allProducts);
        } catch {
            document.getElementById('productList').innerHTML =
                '<div class="text-mono text-muted-hk">* Error loading data. Try again later.</div>';
        }
    }

    function renderProducts(list) {
        const selected = buildState[currentSlot];
        const html = list.length === 0
            ? '<div class="text-mono text-muted-hk">* No components in this category yet.</div>'
            : list.map(p => `
                <div class="mini-product-item ${selected?.productId === p.id ? 'selected' : ''}"
                     onclick="selectProduct(${JSON.stringify(p).replace(/"/g, '&quot;')})"
                     id="mini-${p.id}">
                    <img class="mini-product-img" src="${p.imageUrl}" alt="${p.name}" loading="lazy"
                         onerror="this.src='/images/placeholder.png'"/>
                    <div>
                        <div class="mini-product-name">${p.name}</div>
                        <div class="mini-product-price">${p.priceFormatted}</div>
                    </div>
                </div>`).join('');
        document.getElementById('productList').innerHTML = html;
    }

    function filterProducts(query) {
        const q = query.toLowerCase();
        renderProducts(allProducts.filter(p => p.name.toLowerCase().includes(q)));
    }

    // ============================================================
    // SELECT A PRODUCT INTO A SLOT  (calls server session)
    // ============================================================
    async function selectProduct(product) {
        if (!currentSlot) return;
        try {
            const res  = await fetch('/Build/SelectProduct', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: `slot=${encodeURIComponent(currentSlot)}&productId=${product.id}`
            });
            const data = await res.json();
            if (!data.success) { alert(data.message); return; }

            buildState[currentSlot] = product;
            updateSlotUI(currentSlot, product);
            updateTotals();
            closeSelectPanel();
            runCompatibilityCheck();
            runPerformanceAnalysis();
        } catch { alert('* Server connection error.'); }
    }

    async function clearSlot(slotKey) {
        buildState[slotKey] = null;
        await fetch('/Build/RemoveSlot', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: `slot=${encodeURIComponent(slotKey)}`
        });
        const el = document.getElementById(`slot-${slotKey}`);
        el.classList.remove('filled', 'error');
        document.getElementById(`selected-${slotKey}`).textContent = 'Select part...';
        document.getElementById(`selected-${slotKey}`).className = 'slot-selected text-muted-hk';
        document.getElementById(`price-${slotKey}`).textContent = '—';
        document.getElementById(`btn-clear-${slotKey}`).style.display = 'none';
        updateTotals();
        runCompatibilityCheck();
        runPerformanceAnalysis();
    }

    function updateSlotUI(slotKey, product) {
        const slotEl = document.getElementById(`slot-${slotKey}`);
        slotEl.classList.add('filled');
        const nameEl = document.getElementById(`selected-${slotKey}`);
        nameEl.textContent = product.name;
        nameEl.className = 'slot-selected';
        document.getElementById(`price-${slotKey}`).textContent = PRICE_FORMATTER.format(product.price);
        document.getElementById(`btn-clear-${slotKey}`).style.display = 'inline-flex';
    }

    // ============================================================
    // UPDATE TOTAL PRICE
    // ============================================================
    function updateTotals() {
        let total = 0, filled = 0;
        for (const [key, product] of Object.entries(buildState)) {
            if (product) { total += product.price; filled++; }
        }

        const el = document.getElementById('totalPrice');
        el.textContent = PRICE_FORMATTER.format(total);
        el.classList.add('bump');
        setTimeout(() => el.classList.remove('bump'), 350);

        document.getElementById('slotsFilled').textContent = filled;
    }

    // ============================================================
    // COMPATIBILITY CHECK — gọi POST /api/compatibility
    // ============================================================
    async function runCompatibilityCheck() {
        const slots = {};
        for (const [slot, item] of Object.entries(buildState))
            if (item) slots[slot] = item.id ?? item.productId;

        if (!Object.keys(slots).length) { resetCompatUI(); return; }

        try {
            const res  = await fetch('/api/compatibility', {
                method:  'POST',
                headers: { 'Content-Type': 'application/json' },
                body:    JSON.stringify(slots),
            });
            const data = await res.json();
            updateCompatItem('compat-socket', data.socket);
            updateCompatItem('compat-ram',    data.ram);
            updateCompatItem('compat-psu',    data.psu);
            updateCompatItem('compat-form',   data.form);
        } catch { resetCompatUI(); }
    }

    function resetCompatUI() {
        ['compat-socket','compat-ram','compat-psu','compat-form'].forEach(id => {
            const el = document.getElementById(id);
            el.className = 'compat-item';
            el.querySelector('span').textContent = '⬜';
        });
    }

    function updateCompatItem(id, result) {
        if (!result) return;
        const el = document.getElementById(id);
        if (result.ok === null || result.ok === undefined) {
            el.className = 'compat-item';
            el.innerHTML = `<span>⬜</span> ${result.message}`;
        } else if (result.ok) {
            el.className = 'compat-item ok';
            el.innerHTML = `<span>✅</span> ${result.message}`;
        } else {
            el.className = 'compat-item error';
            el.innerHTML = `<span>❌</span> ${result.message}`;
        }
    }

    // ============================================================
    // PERFORMANCE ANALYSIS — gọi POST /api/performance
    // Cập nhật cả Bottleneck Analyzer + FPS Estimator + Build Badge
    // ============================================================
    async function runPerformanceAnalysis() {
        if (!buildState.cpu || !buildState.gpu) {
            document.getElementById('barCpu').style.width = '50%';
            document.getElementById('barGpu').style.width = '50%';
            document.getElementById('bottleneckLabel').textContent = '—';
            document.getElementById('bottleneckHint').textContent  = '* Select CPU & GPU to see analysis';
            document.getElementById('fpsTableWrap').innerHTML =
                '<div class="text-mono" style="font-size:0.75rem;color:var(--text-muted);">* Select CPU + GPU to see FPS estimation</div>';
            document.getElementById('buildBadge').style.display = 'none';
            return;
        }

        const cpuId = buildState.cpu.id ?? buildState.cpu.productId;
        const gpuId = buildState.gpu.id ?? buildState.gpu.productId;

        try {
            const res  = await fetch('/api/performance', {
                method:  'POST',
                headers: { 'Content-Type': 'application/json' },
                body:    JSON.stringify({ cpuId, gpuId }),
            });
            const d = await res.json();

            // Bottleneck bar
            document.getElementById('barCpu').style.width = d.cpuPct + '%';
            document.getElementById('barGpu').style.width = d.gpuPct + '%';
            const diff  = d.bottleneck;
            const label = diff < 10 ? '✓ BALANCED'
                        : d.cpuPct < d.gpuPct ? `CPU -${diff}%` : `GPU -${diff}%`;
            document.getElementById('bottleneckLabel').textContent = label;
            document.getElementById('bottleneckHint').textContent  = d.bottleneckHint;

            // FPS table
            renderFpsTable(d.fpsTable);

            // Build badge
            document.getElementById('buildBadgeText').textContent = `🎮 ${d.badge}`;
            document.getElementById('buildBadge').style.display   = 'block';
        } catch {
            document.getElementById('bottleneckHint').textContent = '* API connection error.';
        }
    }

    function renderFpsTable(rows) {
        if (!rows || !rows.length) return;
        const cls = fps => fps >= 120 ? 'fps-good' : fps >= 60 ? 'fps-ok' : 'fps-bad';
        document.getElementById('fpsTableWrap').innerHTML = `
            <table class="fps-table">
                <thead>
                    <tr>
                        <th style="text-align:left">GAME</th>
                        <th>1080p</th><th>1440p</th><th>4K</th>
                    </tr>
                </thead>
                <tbody>
                    ${rows.map(r => `
                        <tr>
                            <td>${r.game}</td>
                            <td class="${cls(r.fps1080)}">${r.fps1080}</td>
                            <td class="${cls(r.fps1440)}">${r.fps1440}</td>
                            <td class="${cls(r.fps4k)}">${r.fps4k}</td>
                        </tr>`).join('')}
                </tbody>
            </table>
            <div class="text-mono mt-1" style="font-size:0.65rem;color:var(--text-muted);">
                * Estimate based on benchmark score, actual FPS may vary ±15%
            </div>`;
    }

    // ============================================================
    // ADD BUILD TO CART  (calls /Cart/AddBuild)
    // ============================================================
    async function addBuildToCart() {
        const productIds = Object.values(buildState)
            .filter(v => v !== null)
            .map(p => p.id ?? p.productId);
        if (productIds.length === 0) {
            showToast('* Please select at least 1 part!', 'warn'); return;
        }
        try {
            const res  = await fetch('/Cart/AddBuild', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(productIds)
            });
            const data = await res.json();
            if (data.success) {
                showToast(`✅ ${data.message}`, 'ok');
                updateCartBadge(data.cartCount);
            } else {
                showToast(`❌ ${data.message}`, 'error');
            }
        } catch { showToast('* Connection error.', 'error'); }
    }

    // ============================================================
    // SAVE BUILD (calls /Build/SaveBuild)
    // ============================================================
    function toggleSavePanel() {
        const panel = document.getElementById('saveBuildPanel');
        panel.style.display = panel.style.display === 'none' ? 'flex' : 'none';
    }

    async function saveBuild() {
        const name = document.getElementById('buildNameInput').value.trim() || 'My Build';
        try {
            const res  = await fetch('/Build/SaveBuild', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: `buildName=${encodeURIComponent(name)}`
            });
            const data = await res.json();
            if (data.success) {
                showToast(`✅ ${data.message}`, 'ok');
                toggleSavePanel();
            } else {
                showToast(`⚠️ ${data.message}`, 'warn');
                if (data.message.includes('đăng nhập'))
                    setTimeout(() => window.location.href = '/Account/Login', 1500);
            }
        } catch { showToast('* Connection error.', 'error'); }
    }

    async function clearBuild() {
        await fetch('/Build/ClearAll', { method: 'POST' });
        Object.keys(buildState).forEach(k => { buildState[k] = null; });
        document.querySelectorAll('.build-slot').forEach(el => el.classList.remove('filled','error'));
        document.querySelectorAll('[id^="selected-"]').forEach(el => {
            el.textContent = 'Select part...'; el.className = 'slot-selected text-muted-hk';
        });
        document.querySelectorAll('[id^="price-"]').forEach(el => el.textContent = '—');
        document.querySelectorAll('[id^="btn-clear-"]').forEach(el => el.style.display = 'none');
        updateTotals();
        document.getElementById('fpsTableWrap').innerHTML =
            '<div class="text-mono" style="font-size:0.75rem;color:var(--text-muted);">* Select CPU + GPU to see FPS estimation</div>';
        document.getElementById('buildBadge').style.display = 'none';
        document.getElementById('bottleneckLabel').textContent = '—';
        document.getElementById('bottleneckHint').textContent = '* Select CPU & GPU to see analysis';
    }

    // ============================================================
    // HELPERS
    // ============================================================
    function updateCartBadge(count) {
        const badge = document.getElementById('cartCountBadge');
        if (badge) { badge.textContent = count; badge.style.display = count > 0 ? 'inline' : 'none'; }
    }

    function showToast(message, type = 'ok') {
        const colors = { ok: 'var(--green-kindness)', warn: 'var(--gold)', error: 'var(--red-soul)' };
        const toast = document.createElement('div');
        toast.style.cssText = `position:fixed;bottom:24px;right:24px;z-index:9999;padding:12px 20px;
            background:var(--bg-card);border:2px solid ${colors[type]};font-family:var(--font-mono);
            font-size:0.85rem;color:${colors[type]};animation:slideDown 0.3s ease;`;
        toast.textContent = message;
        document.body.appendChild(toast);
        setTimeout(() => toast.remove(), 3000);
    }
</script>
}
