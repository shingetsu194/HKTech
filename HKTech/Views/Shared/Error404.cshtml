@{
    ViewData["Title"] = "404 — Not Found";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-hk text-center" style="padding: 80px 0;">
    <div style="font-family:var(--font-pixel); font-size:3rem; color:var(--red-soul);
                text-shadow:var(--glow-red); margin-bottom:var(--space-lg);">
        404
    </div>

    <div class="dialog-box" style="max-width:520px; margin:0 auto var(--space-xl);">
        <p class="text-mono" style="font-size:0.9rem; color:var(--text-muted);">* ...</p>
        <p class="text-mono" style="font-size:0.9rem;">
            Trang này không tồn tại trong THE UNDERGROUND.
        </p>
        <p class="text-mono" style="font-size:0.9rem; color:var(--text-muted);">* ...</p>
        <p class="text-mono" style="font-size:0.9rem;">
            Có lẽ nó đã bị SANS xử lý rồi.
        </p>
    </div>

    <!-- Pixel heart animation -->
    <div style="margin: var(--space-xl) 0;">
        <svg width="48" height="42" viewBox="0 0 8 6" shape-rendering="crispEdges"
             xmlns="http://www.w3.org/2000/svg" class="pixel-heart-group">
            <rect x="1" y="0" width="2" height="1" fill="#FF4444"/>
            <rect x="5" y="0" width="2" height="1" fill="#FF4444"/>
            <rect x="0" y="1" width="8" height="2" fill="#FF4444"/>
            <rect x="1" y="3" width="6" height="1" fill="#FF4444"/>
            <rect x="2" y="4" width="4" height="1" fill="#FF4444"/>
            <rect x="3" y="5" width="2" height="1" fill="#FF4444"/>
            <rect x="1" y="0" width="1" height="1" fill="#FF9999"/>
            <rect x="5" y="0" width="1" height="1" fill="#FF9999"/>
        </svg>
    </div>

    <div class="text-pixel-vn text-gold mb-4" style="font-size:1.2rem;">
        ĐỪNG TỪ BỎ!
    </div>

    <div class="d-flex gap-3 justify-content-center">
        <a href="/" class="btn-ut btn-ut-primary btn-vn">
            <i class="bi bi-house-fill"></i> TRANG CHỦ
        </a>
        <a href="/Build" class="btn-ut btn-ut-outline btn-en">
            BUILD PC
        </a>
        <a href="/Product" class="btn-ut btn-ut-ghost btn-en">
            LINH KIỆN
        </a>
    </div>

    <div class="text-mono mt-5" style="font-size:0.7rem; color:var(--text-muted);">
        * DETERMINATION fills your SOUL.<br/>
        * But this page is still EMPTY.
    </div>
</div>
