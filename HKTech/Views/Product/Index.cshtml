@model List<HKTech.Models.Product>
@{
    ViewData["Title"] = "Danh sách Linh kiện";
    ViewData["Description"] = "Khám phá toàn bộ linh kiện máy tính: CPU, GPU, RAM, Mainboard, PSU, Case tại HKTech.";
}


@section Styles {
<style>
    .product-page-layout {
        display: grid;
        grid-template-columns: 240px 1fr;
        gap: var(--space-xl);
        align-items: start;
    }
    @@media (max-width: 768px) {
        .product-page-layout { grid-template-columns: 1fr; }
        .filter-sidebar { display: none; }
        .filter-sidebar.mobile-open { display: block; }
    }

    .filter-sidebar {
        background: var(--bg-surface);
        border: var(--border-muted);
        border-top: 3px solid var(--gold-dim);
        padding: var(--space-lg);
        position: sticky;
        top: 80px;
    }

    .filter-title {
        /* ASCII now → Press Start 2P */
        font-family: var(--font-pixel);
        font-size: 0.55rem;
        color: var(--gold);
        letter-spacing: 3px;
        margin-bottom: var(--space-md);
        padding-bottom: var(--space-sm);
        border-bottom: var(--border-muted);
    }

    .filter-group { margin-bottom: var(--space-lg); }
    .filter-group-label {
        font-family: var(--font-mono);
        font-size: 0.8rem;
        color: var(--text-secondary);
        margin-bottom: var(--space-sm);
    }

    .filter-chip {
        display: block;
        padding: 6px 10px;
        font-family: var(--font-mono);
        font-size: 0.8rem;
        color: var(--text-muted);
        cursor: pointer;
        transition: all var(--transition-fast);
        border-left: 3px solid transparent;
        margin-bottom: 2px;
        text-decoration: none;
    }
    .filter-chip:hover { color: var(--gold); border-left-color: var(--gold-dim); background: var(--gold-glow); }
    .filter-chip.active { color: var(--gold); border-left-color: var(--gold); font-weight: bold; }

    .product-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-md);
        margin-bottom: var(--space-lg);
        flex-wrap: wrap;
    }

    .search-bar {
        flex: 1;
        min-width: 200px;
    }

    .sort-select {
        background: var(--bg-void);
        border: 1px solid #333;
        color: var(--text-secondary);
        padding: var(--space-sm) var(--space-md);
        font-family: var(--font-mono);
        font-size: 0.85rem;
        border-radius: 0;
        outline: none;
    }
    .sort-select:focus { border-color: var(--gold); }
</style>
}

<div class="container-hk" style="padding-top: var(--space-xl);">
    <div class="section-header">
        <h1 class="section-title-pixel">🖥️ LINH KIỆN</h1>
        <div class="section-line"></div>
    </div>

    <div class="product-page-layout">

        <!-- SIDEBAR FILTER -->
        <aside class="filter-sidebar" id="filterSidebar">
            <div class="filter-title">⚙ FILTER</div>

            <div class="filter-group">
                <div class="filter-group-label">CATEGORY</div>
                <a class="filter-chip active" asp-controller="Product" asp-action="Index" id="cat-all">
                    Tất cả
                </a>
                @{
                    var cats = new[]
                    {
                        new { Slug = "cpu",       Name = "🧠 CPU" },
                        new { Slug = "gpu",       Name = "🎮 GPU / VGA" },
                        new { Slug = "mainboard", Name = "🧩 Mainboard" },
                        new { Slug = "ram",       Name = "💾 RAM" },
                        new { Slug = "psu",       Name = "⚡ Nguồn PSU" },
                        new { Slug = "case",      Name = "🗄️ Case / Vỏ" },
                        new { Slug = "storage",   Name = "💿 Ổ cứng / SSD" },
                        new { Slug = "cooling",   Name = "❄️ Tản nhiệt" },
                    };
                }
                @foreach (var cat in cats)
                {
                    <a class="filter-chip" asp-controller="Product" asp-action="Index"
                       asp-route-category="@cat.Slug" id="cat-filter-@cat.Slug">
                        @cat.Name
                    </a>
                }
            </div>

            <div class="filter-group form-hk">
                <div class="filter-group-label">PRICE</div>
                <div style="display:flex; gap:8px; flex-direction:column;">
                    <input type="number" class="form-control-hk" placeholder="Giá từ (VND)" id="priceMin" style="font-size:0.8rem;" />
                    <input type="number" class="form-control-hk" placeholder="Giá đến (VND)" id="priceMax" style="font-size:0.8rem;" />
                    <button class="btn-ut btn-ut-outline btn-en" onclick="applyPriceFilter()"
                            style="width:100%; justify-content:center;">
                        APPLY
                    </button>
                </div>
            </div>
        </aside>

        <!-- PRODUCT MAIN -->
        <div>
            <!-- Toolbar -->
            <div class="product-toolbar">
                <div class="search-bar form-hk">
                    <input type="text" class="form-control-hk" placeholder="🔍 Tìm linh kiện..."
                           id="productSearchInput" oninput="searchProducts(this.value)" />
                </div>
                <select class="sort-select" id="sortSelect" onchange="sortProducts(this.value)">
                    <option value="default">Sắp xếp: Mặc định</option>
                    <option value="price-asc">Giá: Thấp → Cao</option>
                    <option value="price-desc">Giá: Cao → Thấp</option>
                    <option value="name-asc">Tên: A → Z</option>
                </select>
            </div>

            <!-- Product Grid — bind từ Model (Phase 2) -->
            <div class="products-grid" id="productGrid">
                @if (Model != null && Model.Any())
                {
                    @foreach (var p in (List<HKTech.Models.Product>)Model)
                    {
                        <div class="product-card" id="product-card-@p.Id">
                            <div class="card-img-wrap" style="height:200px; background:#111; display:flex; align-items:center; justify-content:center;">
                                @if (p.PrimaryImageUrl != null)
                                {
                                    <img src="@p.PrimaryImageUrl" alt="@p.Name"
                                         style="width:100%; height:100%; object-fit:contain; padding:12px;" />
                                }
                                else
                                {
                                    <span style="font-size:3rem;">@p.Category.Icon</span>
                                }
                            </div>
                            <div class="card-body-hk">
                                <div class="card-category text-mono" style="font-size:0.7rem; color:var(--text-muted); margin-bottom:4px;">
                                    @p.Category.Icon @p.Category.Name
                                </div>
                                <div class="card-title" style="font-family:var(--font-mono); font-size:0.85rem; color:var(--text-primary); margin-bottom:8px; line-height:1.4;">
                                    @p.Name
                                </div>
                                <div class="card-price text-pixel" style="font-size:0.6rem; color:var(--gold); text-shadow:var(--glow-gold);">
                                    @p.Price.ToString("N0")₫
                                </div>
                                @if (p.StockQuantity <= 0)
                                {
                                    <div style="font-size:0.7rem; color:var(--red-soul); margin-top:4px;">● Hết hàng</div>
                                }
                                else if (p.StockQuantity <= 5)
                                {
                                    <div style="font-size:0.7rem; color:var(--gold); margin-top:4px;">⚠ Còn @p.StockQuantity cái</div>
                                }
                            </div>
                            <div class="card-actions">
                                <a asp-controller="Product" asp-action="Detail" asp-route-id="@p.Id"
                                   class="btn-ut btn-ut-outline btn-en" style="font-size:0.7rem; padding:6px 12px;"
                                   id="btn-detail-@p.Id">
                                    CHI TIẾT
                                </a>
                                <button class="btn-ut btn-ut-primary btn-en" style="font-size:0.7rem; padding:6px 12px;"
                                        onclick="addToCartQuick(@p.Id, '@p.Name.Replace("'", "\\'")', @p.Price)"
                                        id="btn-cart-@p.Id">
                                    + GIỎ
                                </button>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="dialog-box" style="grid-column:1/-1;">
                        * Không tìm thấy sản phẩm nào phù hợp với bộ lọc.
                    </div>
                }
            </div>

            @{
                int page = ViewBag.Page ?? 1;
                int totalPages = ViewBag.TotalPages ?? 1;
            }
            @if (totalPages > 1)
            {
                <div class="d-flex gap-2 mt-4 flex-wrap">
                    @if (page > 1)
                    {
                        <a asp-controller="Product" asp-action="Index"
                           asp-route-page="@(page-1)" asp-route-category="@ViewBag.Category"
                           asp-route-search="@ViewBag.Search" asp-route-sort="@ViewBag.Sort"
                           class="btn-ut btn-ut-ghost btn-en" style="font-size:0.75rem;">← TRƯỚC</a>
                    }
                    @for (int i = 1; i <= totalPages; i++)
                    {
                        <a asp-controller="Product" asp-action="Index"
                           asp-route-page="@i" asp-route-category="@ViewBag.Category"
                           asp-route-search="@ViewBag.Search" asp-route-sort="@ViewBag.Sort"
                           class="btn-ut @(i == page ? "btn-ut-primary" : "btn-ut-ghost") btn-en"
                           style="font-size:0.75rem; min-width:36px; text-align:center;">@i</a>
                    }
                    @if (page < totalPages)
                    {
                        <a asp-controller="Product" asp-action="Index"
                           asp-route-page="@(page+1)" asp-route-category="@ViewBag.Category"
                           asp-route-search="@ViewBag.Search" asp-route-sort="@ViewBag.Sort"
                           class="btn-ut btn-ut-ghost btn-en" style="font-size:0.75rem;">SAU →</a>
                    }
                </div>
            }
            <div class="text-mono mt-2" style="font-size:0.75rem; color:var(--text-muted);">
                Hiển thị @((List<HKTech.Models.Product>)Model!).Count() / @ViewBag.TotalCount sản phẩm
            </div>
        </div>

    </div>
</div>

