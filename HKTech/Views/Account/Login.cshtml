@model HKTech.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
}

<div class="container-hk" style="max-width:480px; padding: var(--space-xl) 0;">

    <div class="section-header">
        <h1 class="section-title-pixel">⚔️ ĐĂNG NHẬP</h1>
        <div class="section-line"></div>
    </div>

    <div class="dialog-box mb-4">
        * Chào mừng trở lại! Nhập thông tin để tiếp tục hành trình xây dựng PC của bạn.
    </div>

    <div style="background: var(--bg-surface); border: var(--border-gold); padding: var(--space-xl);">
        <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" class="form-hk">
            @Html.AntiForgeryToken()

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert-ut alert-ut-danger mb-3">
                    @Html.ValidationSummary(true, "", new { @class = "" })
                </div>
            }

            <div class="mb-3">
                <label asp-for="Email" class="form-label">📧 EMAIL</label>
                <input asp-for="Email" class="form-control-hk" placeholder="your@email.com" autocomplete="email" />
                <span asp-validation-for="Email" class="text-danger" style="font-size:0.8rem;"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label">🔐 MẬT KHẨU</label>
                <input asp-for="Password" class="form-control-hk" placeholder="••••••••" autocomplete="current-password" />
                <span asp-validation-for="Password" class="text-danger" style="font-size:0.8rem;"></span>
            </div>

            <div class="mb-4 d-flex align-items-center gap-2">
                <input asp-for="RememberMe" type="checkbox" id="rememberMe" />
                <label asp-for="RememberMe" class="text-mono" style="font-size:0.85rem; cursor:pointer;">
                    Nhớ đăng nhập (7 ngày)
                </label>
            </div>

            <button type="submit" class="btn-ut btn-ut-primary btn-vn w-100" id="btn-login-submit"
                    style="padding:12px; font-size:1rem;">
                ♥ ĐĂNG NHẬP
            </button>
        </form>

        <div class="text-center mt-4 text-mono" style="font-size:0.85rem; color:var(--text-muted);">
            Chưa có tài khoản?
            <a asp-controller="Account" asp-action="Register"
               class="text-gold text-decoration-none">Đăng ký ngay →</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
