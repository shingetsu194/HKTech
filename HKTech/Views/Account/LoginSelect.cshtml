@{
    ViewData["Title"] = "Login";
}

<div class="container-hk" style="max-width:680px; padding: var(--space-xl) 0;">

    <div class="section-header">
        <h1 class="section-title-pixel">⚔️ LOGIN</h1>
        <div class="section-line"></div>
    </div>

    <div class="dialog-box mb-5">
        * Welcome to HKTech PC Builder! Please select your login method.
    </div>

    <div class="row g-4">

        <!-- Customer -->
        <div class="col-md-6">
            <a asp-controller="Account" asp-action="Login"
               class="login-select-card" id="login-select-customer" style="text-decoration:none;">
                <div class="login-select-icon">
                    <svg width="80" height="60" viewBox="0 0 8 6" shape-rendering="crispEdges"
                         xmlns="http://www.w3.org/2000/svg"
                         style="filter:drop-shadow(0 0 8px rgba(255,215,0,0.9)) drop-shadow(0 0 24px rgba(255,215,0,0.4));">
                        <rect x="1" y="0" width="2" height="1" fill="#FFD700"/>
                        <rect x="5" y="0" width="2" height="1" fill="#FFD700"/>
                        <rect x="0" y="1" width="8" height="2" fill="#FFD700"/>
                        <rect x="1" y="3" width="6" height="1" fill="#FFD700"/>
                        <rect x="2" y="4" width="4" height="1" fill="#FFD700"/>
                        <rect x="3" y="5" width="2" height="1" fill="#FFD700"/>
                        <rect x="1" y="0" width="1" height="1" fill="#FFE566"/>
                        <rect x="5" y="0" width="1" height="1" fill="#FFE566"/>
                    </svg>
                </div>
                <div class="login-select-title" style="color:var(--gold);">CUSTOMER</div>
                <div class="login-select-desc">
                    Log in to shop, save PC builds and track your orders.
                </div>
                <div class="login-select-btn" style="border-color:var(--gold); color:var(--gold);">
                    CONTINUE →
                </div>
            </a>
        </div>

        <!-- Admin -->
        <div class="col-md-6">
            <a asp-controller="Account" asp-action="AdminLogin"
               class="login-select-card login-select-admin" id="login-select-admin" style="text-decoration:none;">
<div class="login-select-icon">
                    <svg width="80" height="50" viewBox="0 0 8 5" shape-rendering="crispEdges"
                         xmlns="http://www.w3.org/2000/svg"
                         style="filter:drop-shadow(0 0 8px rgba(77,158,255,0.9)) drop-shadow(0 0 24px rgba(77,158,255,0.4));">
                        <!-- Crown tines (3x double-wide) -->
                        <rect x="0" y="0" width="2" height="2" fill="#4D9EFF"/>
                        <rect x="3" y="0" width="2" height="2" fill="#4D9EFF"/>
                        <rect x="6" y="0" width="2" height="2" fill="#4D9EFF"/>
                        <!-- Crown body -->
                        <rect x="0" y="2" width="8" height="3" fill="#4D9EFF"/>
                        <!-- Highlights -->
                        <rect x="0" y="0" width="2" height="1" fill="#80C0FF"/>
                        <rect x="3" y="0" width="2" height="1" fill="#80C0FF"/>
                        <rect x="6" y="0" width="2" height="1" fill="#80C0FF"/>
                        <rect x="0" y="2" width="8" height="1" fill="#80C0FF"/>
                        <!-- Gems: gold left/right, red center -->
                        <rect x="1" y="3" width="1" height="1" fill="#FFD700"/>
                        <rect x="3" y="3" width="2" height="1" fill="#FF4444"/>
                        <rect x="6" y="3" width="1" height="1" fill="#FFD700"/>
                    </svg>
                </div>
                <div class="login-select-title" style="color:var(--sans-blue); text-shadow: var(--glow-sans);">ADMIN</div>
                <div class="login-select-desc">
                    For system administrators. Special authentication required.
                </div>
                <div class="login-select-btn" style="border-color:var(--sans-blue); color:var(--sans-blue);">
                    CONTINUE →
                </div>
            </a>
        </div>

    </div>

    <div class="text-center mt-5 text-mono" style="font-size:0.85rem; color:var(--text-muted);">
        Don't have an account?
        <a asp-controller="Account" asp-action="Register"
           class="text-gold text-decoration-none">Register now →</a>
    </div>
</div>

@section Styles {
<style>
    /* ── Login Select Cards ── */
    :root {
        --sans-blue:  #4D9EFF;
        --sans-cyan:  #00DDFF;
        --sans-dark:  #050A14;
        --glow-sans:  0 0 8px #4D9EFF, 0 0 20px rgba(77,158,255,0.3);
    }

    .login-select-card {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        gap: 16px;
        padding: 36px 24px;
        background: var(--bg-surface);
        border: 2px solid #333;
        border-top: 4px solid var(--gold);
        cursor: pointer;
        transition: all 0.2s ease;
        height: 100%;
    }

    .login-select-card:hover {
        transform: translateY(-6px);
        border-color: var(--gold);
        box-shadow: 0 12px 40px var(--gold-glow);
    }

    .login-select-admin {
        border-top-color: var(--sans-blue);
    }

    .login-select-admin:hover {
        border-color: var(--sans-blue);
        box-shadow: 0 12px 40px rgba(77,158,255,0.25);
    }

    .login-select-icon {
        line-height: 0;
        animation: heartbeat 1.5s ease-in-out infinite;
    }

    .login-select-admin .login-select-icon {
        animation: sans-float 2s ease-in-out infinite;
    }

    @@keyframes sans-float {
        0%, 100% { transform: translateY(0) rotate(-3deg); }
        50%       { transform: translateY(-6px) rotate(3deg); }
    }

    .login-select-title {
        font-family: var(--font-pixel);
        font-size: 0.65rem;
        letter-spacing: 2px;
    }

    .login-select-desc {
        font-family: var(--font-mono);
        font-size: 0.85rem;
        color: var(--text-muted);
        line-height: 1.6;
        flex: 1;
    }

    .login-select-btn {
        font-family: var(--font-pixel);
        font-size: 0.5rem;
        padding: 8px 16px;
        border: 2px solid;
        letter-spacing: 1px;
        transition: all 0.15s ease;
    }

    .login-select-card:hover .login-select-btn {
        background: rgba(255,215,0,0.1);
    }

    .login-select-admin:hover .login-select-btn {
        background: rgba(77,158,255,0.1);
    }
</style>
}
