@{
    ViewData["Title"] = "403 — Không có quyền";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-hk text-center" style="padding: 80px 0;">
    <div style="font-family:var(--font-pixel); font-size:3rem; color:var(--gold);
                text-shadow:var(--glow-gold); margin-bottom:var(--space-lg);">
        403
    </div>

    <div class="dialog-box" style="max-width:540px; margin:0 auto var(--space-xl);">
        <p class="text-mono" style="font-size:0.9rem; color:var(--text-muted);">* ...</p>
        <p class="text-mono" style="font-size:0.9rem;">
            Bạn KHÔNG có quyền truy cập khu vực này.
        </p>
        <p class="text-mono" style="font-size:0.9rem; color:var(--text-muted);">
            * Khu vực này chỉ dành cho Quản trị viên (Admin).
        </p>
    </div>

    <!-- Pixel heart -->
    <div style="margin: var(--space-xl) 0;">
        <svg width="48" height="42" viewBox="0 0 8 6" shape-rendering="crispEdges"
             xmlns="http://www.w3.org/2000/svg" class="pixel-heart-group">
            <rect x="1" y="0" width="2" height="1" fill="#FFD700"/>
            <rect x="5" y="0" width="2" height="1" fill="#FFD700"/>
            <rect x="0" y="1" width="8" height="2" fill="#FFD700"/>
            <rect x="1" y="3" width="6" height="1" fill="#FFD700"/>
            <rect x="2" y="4" width="4" height="1" fill="#FFD700"/>
            <rect x="3" y="5" width="2" height="1" fill="#FFD700"/>
        </svg>
    </div>

    <div class="text-pixel-vn text-gold mb-4" style="font-size:1.2rem;">
        DỪNG LẠI Ở ĐÂY THÔI!
    </div>

    <div class="d-flex gap-3 justify-content-center">
        <a href="/" class="btn-ut btn-ut-primary btn-vn">
            <i class="bi bi-house-fill"></i> TRANG CHỦ
        </a>
        <a href="/Product" class="btn-ut btn-ut-ghost btn-en">
            LINH KIỆN
        </a>
    </div>

    <div class="text-mono mt-5" style="font-size:0.7rem; color:var(--text-muted);">
        * Chỉ có DETERMINATION thôi là chưa đủ.<br/>
        * Bạn cần quyền ADMIN để vào khu vực này.
    </div>
</div>
